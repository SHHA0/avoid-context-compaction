{
  "description": "Avoid Context Compaction usage warnings, compaction markers, and handoff recovery.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CODEX_HOME/skills/avoid-context-compaction/scripts/avoid_context_compaction.py\" hook",
            "commandWindows": "python \"%CODEX_HOME%\\skills\\avoid-context-compaction\\scripts\\avoid_context_compaction.py\" hook",
            "timeout": 10,
            "additionalContextLimit": 1800,
            "statusMessage": "Restoring context checkpoint"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CODEX_HOME/skills/avoid-context-compaction/scripts/avoid_context_compaction.py\" hook",
            "commandWindows": "python \"%CODEX_HOME%\\skills\\avoid-context-compaction\\scripts\\avoid_context_compaction.py\" hook",
            "timeout": 10,
            "additionalContextLimit": 600,
            "statusMessage": "Checking context usage"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CODEX_HOME/skills/avoid-context-compaction/scripts/avoid_context_compaction.py\" hook",
            "commandWindows": "python \"%CODEX_HOME%\\skills\\avoid-context-compaction\\scripts\\avoid_context_compaction.py\" hook",
            "timeout": 10,
            "additionalContextLimit": 600,
            "statusMessage": "Checking context usage"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CODEX_HOME/skills/avoid-context-compaction/scripts/avoid_context_compaction.py\" hook",
            "commandWindows": "python \"%CODEX_HOME%\\skills\\avoid-context-compaction\\scripts\\avoid_context_compaction.py\" hook",
            "timeout": 10,
            "statusMessage": "Saving compaction marker"
          }
        ]
      }
    ]
  }
}
